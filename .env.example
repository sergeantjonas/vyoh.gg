POSTGRES_USER=vyoh
POSTGRES_PASSWORD=vyoh
POSTGRES_DB=vyoh
POSTGRES_PORT=5432

DATABASE_URL=postgresql://vyoh:vyoh@localhost:5432/vyoh

# --- api origin, consumed by apps/web (see apps/web/src/lib/api-url.ts) ---
# Both are optional in dev: unset, they fall back to http://localhost:2010,
# which is where Nest listens while Vite serves the app on :2009.
#
# VITE_API_URL is a *build-time* var. Vite reads .env from apps/web/, not from
# this file, so set it in the build environment instead:
#   VITE_API_URL=https://api.vyoh.gg pnpm --filter @vyoh/web build
# It is baked into the bundle and into index.html's og:image, so it must be the
# absolute public origin a browser or a crawler can reach.
#
# API_INTERNAL_URL is a *runtime* var, read only when the app renders on a
# server. It lets SSR loaders reach the api over loopback instead of going back
# out through the public hostname. Unused until the Start migration lands SSR.
VITE_API_URL=https://api.vyoh.gg
API_INTERNAL_URL=http://127.0.0.1:2010

POSTGRES_USER=vyoh
POSTGRES_PASSWORD=vyoh
POSTGRES_DB=vyoh
POSTGRES_PORT=5432

DATABASE_URL=postgresql://vyoh:vyoh@localhost:5432/vyoh

# --- api origin, consumed by apps/web (see apps/web/src/lib/api-url.ts) ---
# Both are optional in dev: unset, they fall back to http://localhost:2010,
# which is where Nest listens while Vite serves the app on :2009.
#
# VITE_API_URL is a *build-time* var. Vite reads .env from apps/web/, not from
# this file, so set it in the build environment instead:
#   VITE_API_URL=https://api.vyoh.gg pnpm --filter @vyoh/web build
# It is baked into the bundle and into the markup head() emits, so it must be
# the absolute public origin a browser or a crawler can reach. compose.prod.yaml
# passes it as a Docker build arg for the same reason.
#
# API_INTERNAL_URL is a *runtime* var, read only when the app renders on a
# server. It lets SSR loaders reach the api directly instead of going back out
# through the public hostname. In the compose stack that is the service name
# (http://api:2010, set in compose.prod.yaml); the loopback form below is for
# running the built server outside a container.
VITE_API_URL=https://api.vyoh.gg
API_INTERNAL_URL=http://127.0.0.1:2010

# Public origin of the site itself, for <link rel="canonical">, og:url and
# /sitemap.xml (apps/web/src/lib/site-url.ts). Build-time, and optional:
# unset it defaults to https://vyoh.gg. Set it for a staging hostname.
# VITE_SITE_URL=https://staging.vyoh.gg

# --- production only (compose.prod.yaml) ---
# Comma-separated CORS allowlist for the api. Required under NODE_ENV=production
# — apps/api/src/main.ts refuses to boot without it, because unset the api falls
# back to allowing any localhost origin, which is a dev default that should
# never reach a public deploy.
WEB_ORIGIN=https://vyoh.gg,https://www.vyoh.gg

# Loopback ports Nginx proxies to. Defaults match the dev ports; override when
# a second project on the same box already claims one.
# WEB_PORT=2009
# API_PORT=2010

# Owner-local timezone for the containers. Containers are UTC by default, and a
# server that formats dates in UTC while the browser formats them in the
# visitor's zone is a hydration mismatch, not a cosmetic difference.
# TZ=Europe/Brussels

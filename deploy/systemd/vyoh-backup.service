# Runs scripts/backup.sh once, then scripts/offsite.sh on the archive it wrote.
# Scheduling lives in the paired .timer.
#
# As deploy, not root, because nothing here needs more. The docker group is all
# `docker compose exec` asks for, deploy owns /srv/vyoh, and the script writes
# only inside /var/backups/vyoh — which is deploy's too, mode 700, so the dumps
# are readable by the account that does everything else on the box.
# /var/backups itself is root's, so the unit cannot create that directory; the
# install does. Nothing here needs the repo's Node toolchain — the dump happens
# inside the postgres container.

[Unit]
Description=vyoh.gg database backup and its off-box copy
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=deploy
Group=deploy
ExecStart=/srv/vyoh/scripts/backup.sh
# The copy that leaves the box. A oneshot runs its ExecStart lines in order and
# stops at the first that fails, so this sends the archive the line above just
# wrote, or nothing.
ExecStart=/srv/vyoh/scripts/offsite.sh

# The upload key and the age recipient, root-only and outside the tree a deploy
# writes to. That does not keep the key from deploy, which drives the Docker
# daemon; what the key can do is what bounds it. Optional so that a missing file
# costs the off-box copy and not the local dump: offsite.sh fails on the unset
# values, and the unit with it.
EnvironmentFile=-/etc/vyoh/offsite.env

# Tells healthchecks.io how the run ended, dump and upload together, with this
# run's journal lines on a failure. The check alerts on silence and the script
# always exits 0, so the '-' covers only the script itself being missing.
ExecStopPost=-/srv/vyoh/scripts/heartbeat.sh vyoh-backup
EnvironmentFile=-/etc/vyoh/heartbeat.env

Environment=VYOH_COMPOSE_FILE=compose.prod.yaml
Environment=VYOH_BACKUP_DIR=/var/backups/vyoh
Environment=VYOH_BACKUP_KEEP=14

# The dump and its verification both read the whole database. On a shared
# 4-core box that is worth yielding to anything actually serving a request.
Nice=10
IOSchedulingClass=idle

# A pg_dump or an upload that hangs should fail the unit rather than hold the
# timer open until the next one is due. The limit covers both ExecStart lines
# together, and the upload alone may retry three times at up to ten minutes each.
TimeoutStartSec=1h

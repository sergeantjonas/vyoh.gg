# One-shot Playwright verification artefacts from agent sessions.
# Real infra in scripts/ (e.g. reset.sh, setup.sh) stays tracked.
scripts/probe-*
scripts/debug-*
scripts/diagnose-*
scripts/screenshot-*
scripts/verify-*

# Perf-probe trace + screenshot output. Root-level so biome's useIgnoreFile
# picks it up (biome only reads the root .gitignore, not nested ones).
tools/perf-probe/runs/

# Force-track AI-tool config surfaces so a malicious postinstall that writes
# one of these shows up in `git status` instead of staying invisible. Triggered
# by the 2026-06-08 Hades campaign — see ~/.claude/CLAUDE.md "Supply-chain
# hardening". Project CLAUDE.md / .claude/ stay ignored per the rules above.

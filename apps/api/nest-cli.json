{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "builder": "swc",
    "deleteOutDir": true,
    "assets": [
      { "include": "og/fonts/*.ttf", "outDir": "dist/src" },
      { "include": "og/assets/*.svg", "outDir": "dist/src" }
    ],
    "watchAssets": true
  }
}

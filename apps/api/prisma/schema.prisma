generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// The tracked-accounts roster: which Riot accounts the API is allowed to
// sync, which slug each answers to on the web, and which of them are the
// owner's own. Read once at boot into `IdentityService`'s cache.
model LolAccount {
  slug      String   @id
  gameName  String
  tagLine   String
  region    String
  isOwner   Boolean  @default(false)
  isPrimary Boolean  @default(false)
  // Reads sort on `createdAt`, so this doubles as roster display order —
  // the nav renders accounts in the order they were added.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One Riot ID, one slug. Registering the same account twice would split
  // its match history across two pages that each look half-synced.
  @@unique([gameName, tagLine, region])
}

model SteamAccount {
  steamId64 String   @id
  // Steam has no non-owner equivalent of the LoL test accounts yet, so a
  // row exists only because it is the owner's.
  isOwner   Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Summoner {
  puuid            String    @id
  gameName         String
  tagLine          String
  region           String
  profileIconId    Int?
  summonerLevel    Int?
  fetchedAt        DateTime  @default(now())
  historicalDoneAt DateTime?

  // Denormalised "current state" snapshot recomputed at every persistence
  // chokepoint (rank-snapshot write, match write) so the nav-bootstrap
  // query reads coherent values in a single Summoner read instead of
  // joining RankSnapshot + Match per account. Nullable: pre-sync state +
  // accounts that have no ranked games + first-tick before any refresh.
  // `currentRankQueue` records which queue won the higher-of-comparison
  // (RANKED_SOLO_5x5 / RANKED_FLEX_SR) so the UI can label the badge.
  currentRankTier         String?
  currentRankDivision     String?
  currentRankLp           Int?
  currentRankQueue        String?
  lastPlayedChampionAlias String?
  summaryUpdatedAt        DateTime?

  matches       Match[]
  rankSnapshots RankSnapshot[]

  @@unique([gameName, tagLine, region])
}

model RankSnapshot {
  id           Int      @id @default(autoincrement())
  puuid        String
  queueId      String
  tier         String
  rank         String
  leaguePoints Int
  wins         Int?
  losses       Int?
  hotStreak    Boolean?
  capturedAt   DateTime @default(now())

  summoner Summoner @relation(fields: [puuid], references: [puuid])

  @@index([puuid, queueId, capturedAt])
}

model MatchDetailCache {
  matchId  String   @id
  detail   Json
  cachedAt DateTime @default(now())
}

model MatchTimelineCache {
  matchId  String   @id
  timeline Json
  cachedAt DateTime @default(now())
}

model SteamOwnedGame {
  appid       Int       @id
  name        String
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  removedAt   DateTime?
  // GetOwnedGames `rtime_last_played` — epoch of the last client-reported
  // launch. Null when Steam reports 0 (never launched) or omits the field.
  // Refreshed on every daily owned-games sync; pairs with the latest unlock
  // timestamp on `SteamPlayerUnlock` to drive the last-progressed verdict.
  rtimeLastPlayed DateTime?

  snapshots       SteamPlaytimeSnapshot[]
  achievements    SteamGameAchievement[]
  achievementMeta SteamGameAchievementMeta?
}

// Per-app metadata fetched from IStoreBrowseService/GetItems. Keyed by appid
// independently of SteamOwnedGame — the enrichment poller backfills both
// owned and wishlist appids so the image proxy can resolve hashed asset
// paths for wishlisted (not-yet-owned) titles too. Assets are stored as
// path fragments (Steam's "${FILENAME}" substitutions, hash-prefixed
// + asset filename in one string, e.g. "1eebc7e0…e4e3/library_capsule.jpg")
// plus a single `assetUrlFormat` template + `assetTimestamp` cache-buster.
// Caller composes the full URL by substituting the path into the format. A
// change in `assetTimestamp` indicates the publisher refreshed art.
//
// `appType` is Steam's StoreItemType enum int: 0 = Game, 6 = Application /
// Software (Wallpaper Engine, 3DMark, OBS-class tools), other values for DLC /
// bundles / demos. Frontend maps to a label. `tagIds` carries the appid's
// community-tag ids ordered by weight desc (top-N stored, full list is huge);
// stand-in for Steam's "genre" metadata which IStoreBrowseService doesn't
// expose directly. `featureCategoryIds` is the small int list under
// `categories.feature_categoryids` for feature-flag filters (single-player,
// achievements, cloud save, etc.). `logoPath` is the per-app SHA1 hash for
// the wordmark/library_logo asset, sourced from PICS' `common.library_assets
// (_full).library_logo` — IStoreBrowseService omits this field. Frontend
// composes `…/store_item_assets/steam/apps/{appid}/{logoPath}/logo.png`.
// Null when PICS didn't return a logo entry (older titles where the
// unhashed legacy mirror is the only path); frontend falls back to that.
model SteamGameEnrichment {
  appid                Int       @id
  assetUrlFormat       String?
  assetTimestamp       BigInt?
  libraryCapsulePath   String?
  libraryCapsule2xPath String?
  libraryHeroPath      String?
  libraryHero2xPath    String?
  headerPath           String?
  heroCapsulePath      String?
  logoPath             String?
  appType              Int?
  releaseDate          DateTime? @db.Date
  // `release.is_coming_soon`. Persisted rather than derived from `releaseDate`,
  // because a pre-purchased title can be coming-soon with no date (TBA
  // pre-order) and Steam keeps the flag raised past the target date until its
  // launch sweep runs. The upcoming surface reads owned-but-unreleased titles
  // off this column — a pre-order leaves the wishlist on purchase, so the
  // library is the only place it still exists.
  comingSoon           Boolean?
  isFree               Boolean?
  tagIds               Int[]
  featureCategoryIds   Int[]
  // `basic_info.short_description` from IStoreBrowseService — the one-line
  // marketing blurb shown on the Steam store card. Typically 150–300 chars.
  // Null when upstream returns no basic_info block (delisted/private apps).
  shortDescription     String?
  // `platforms.steam_deck_compat_category`: 0 Unknown / 1 Unsupported /
  // 2 Playable / 3 Verified. Mirrors Valve's compatibility taxonomy. Null
  // when upstream omits the platforms block; renderer treats null and 0
  // identically (no chip shown).
  steamDeckCompat      Int?
  // OS support flags from `platforms.{windows,mac,linux}` — whether the game
  // *runs* on the platform. Distinct from SteamPlaytimeSnapshot's per-OS
  // playtime, which records the owner's launches; "Mac=true with 0h Mac
  // playtime" ≠ "Mac=false with 0h Mac playtime". `platformVr` is true when
  // `platforms.vr_support` contains any key (any VR mode flag → some VR
  // support); null when the platforms block is missing.
  platformWindows      Boolean?
  platformMac          Boolean?
  platformLinux        Boolean?
  platformVr           Boolean?
  // `reviews.summary_filtered` snapshot — Steam's storefront review chip
  // shape ("Very Positive · 56,501"). JSONB rather than four columns: the
  // four fields move together (a refresh updates them all) and only the
  // game-detail chip reads them at present, so per-field columns would
  // burn schema width without unlocking queries. JSON shape:
  // `{ reviewCount, percentPositive, reviewScore, reviewScoreLabel }`.
  reviewSummary        Json?
  // `game_rating` block (ESRB / PEGI / USK / …) — editorial only, surfaced
  // as a small badge on the game-detail header. JSON shape:
  // `{ type, rating, descriptors, requiredAge, useAgeGate, imageUrl }`.
  // Null is meaningful (AO-rated titles skip ESRB submission); the renderer
  // treats null as "no badge" rather than as a maturity signal — see the
  // working note for the explicit no-NSFW-gating decision.
  gameRating           Json?
  // `basic_info.{publishers,developers,franchises}[].name` flattened to string
  // arrays for the ⌘K palette grammar (`pub:` / `dev:` / `franchise:` verbs).
  // Postgres native arrays (not Json) so future filters can use `&&` / `@>`
  // ops once the dataset is large enough to warrant indexing. Default `[]` so
  // a missing enrichment row and an upstream block with no entities serialise
  // the same — the renderer treats empty as "no chip / no filter hit".
  publisherNames       String[]  @default([])
  developerNames       String[]  @default([])
  franchiseNames       String[]  @default([])
  // BBCode markup body from `full_description_bbcode` — typically 2–8KB per
  // game. Stored raw so a renderer-side sanitiser change doesn't force a
  // re-enrichment pass; the web side runs BBCode → HTML → sanitised HTML on
  // demand via the `/steam/game/:appid/description` endpoint. Null when
  // upstream omits the full description block (DLC / bundle entries, demos).
  fullDescriptionBbcode String?
  // Rendered `about_the_game` HTML from Steam's legacy storefront
  // `appdetails?appids=<appid>&l=en` endpoint. The bulk enrichment call
  // (`IStoreBrowseService/GetStoreItemsFull`, see `fullDescriptionBbcode`
  // above) does not return rendered HTML, and bbcode `[img]` slugs are
  // editorial labels Steam resolves to content-hashed `extras/<hash>.{webm,
  // poster.avif}` URLs server-side. Populated lazily on the first
  // `/steam/game/:appid/description` call so the 500-game library doesn't
  // serialise 500 rate-limited fetches at sync time. Null until first view
  // (or for DLC/bundle entries with no rendered about-block).
  aboutTheGameHtml      String?
  // Storefront screenshots, two server-side buckets from `screenshots.*` on
  // IStoreBrowseService. `screenshotsAllAges` is the storefront default;
  // `screenshotsMature` is the bucket Steam itself gates behind a maturity
  // toggle. JSON shape per entry: `{ filename, ordinal }` — filename composes
  // with the shared `steamScreenshotThumbUrl` / `…FullUrl` helpers. Defaults
  // to `[]` so the renderer's empty-list branch covers both "never enriched"
  // and "upstream returned an empty bucket". Supersede the older lazy
  // `screenshots` + `screenshotsFetchedAt` pair, which Chunk 9c drops.
  screenshotsAllAges   Json      @default("[]")
  screenshotsMature    Json      @default("[]")
  // First-entry microtrailer from `trailers.highlights[0]` — Steam's 6-second
  // silent loop the storefront plays on hover. Captured as flat columns (not
  // a JSON blob) because the renderer reads each independently: webm is the
  // primary `<source>`, mp4 is the H.264 fallback for Safari/legacy, poster
  // is the still under the `<video>` pre-play, name is the `aria-label`. All
  // nullable because (a) the upstream block is optional per item (older
  // titles often skip trailers entirely), (b) per-source codec entries are
  // independently optional within `microtrailer[]`. Paths only — the raw
  // CDN filenames are stored, resolved through the api-side media proxy at
  // request time (mirrors how `library_capsule` etc. resolve, keeps the
  // existing `asset_url_format` cache-buster discipline in one place).
  microtrailerWebm     String?
  microtrailerMp4      String?
  microtrailerPoster   String?
  microtrailerName     String?
  // Full `trailers.highlights[]` payload from IStoreBrowseService, projected
  // to the per-highlight shape consumed by the game-detail trailer modal.
  // Stored as Json (not normalised into a sister table) because the array is
  // small (3-6 trailers per game in practice), the inner shape is stable
  // across publishers, and no query plan needs SQL-level access to its
  // contents — the modal hydrates the whole array client-side and picks the
  // best adaptive variant per browser. Each entry carries: `trailerName`,
  // `trailerCategory`, `allAges`, microtrailer paths (`webm`/`mp4`/`poster`
  // — duplicated with the flat columns above for highlights[0] for
  // back-compat with the hovercard, present for every highlight here),
  // `screenshotMedium` + `screenshotFull` (poster derivatives), and
  // `adaptiveTrailers` array of `{ cdnPath, encoding }` for dash_av1 /
  // dash_h264 / hls_h264. Null while the enrichment cron hasn't run; the
  // renderer treats null and `[]` identically (no modal available).
  trailers             Json?
  // Saliency centroid of `library_hero.jpg`, expressed as integer percent
  // (0-100) on each axis. Computed at enrichment via smartcrop-sharp on the
  // raw upstream bytes and used by the library row's `object-cover`
  // composition as the `objectPosition` anchor so the focal subject stays
  // in the cropped frame regardless of where it sits in the source. Both
  // null when never computed (new app, smartcrop unavailable); a defaulted
  // 50/50 indicates "computed but detection inconclusive" and renders as a
  // center crop. Renderer always treats null as 50/50 too — the distinction
  // is only meaningful to the enrichment job (null → retry; 50/50 → don't).
  subjectXPercent      Int?
  subjectYPercent      Int?
  // When true, the renderer applies `transform: scaleX(-1)` to the hero
  // img so a face detected at the left side of source (where the
  // wordmark logo lives) flips to the right side, clear of the logo. Set
  // at anchor-compute time when the face center X falls below the
  // FLIP_TRIGGER_X_PCT threshold; `subjectXPercent` is also inverted in
  // the same pass so the cover-crop anchor still tracks the face after
  // the flip. Both the library row and the game-detail page hero apply
  // the same transform, so the view-transition morph stays continuous.
  flipHero             Boolean   @default(false)
  dominantHex          String?
  // SteamGridDB fallback hero — populated when `libraryHero2xPath` is null
  // (publisher didn't ship a 2x asset, e.g. RE3). SGDB hosts community-
  // uploaded heroes typically 1920x620 or 3840x1240 native; we accept any
  // width >= 1920 and prefer the highest-scored entry. The URL is the full
  // absolute `cdn2.steamgriddb.com/hero/<hash>.<ext>` path — used directly
  // by `fetchUpstreamChain` from the image proxy. Null when SGDB also has
  // no usable entry (rare; SGDB community covers most titles) or the
  // enrichment pass hasn't yet run.
  sgdbHeroUrl          String?
  sgdbHeroWidth        Int?
  sgdbHeroHeight       Int?
  // Cron-watermark: when SGDB was last *queried* for this appid, regardless
  // of result. Lets the enrichment poller skip recently-checked games (the
  // SGDB API has a per-key rate limit) while still retrying every monthly
  // pass for publishers who later add a 2x asset upstream.
  sgdbEnrichedAt       DateTime?
  enrichedAt           DateTime  @default(now())
}

// Per-asset paths for wishlist titles. Wishlist apps aren't owned, so the
// owned-games sync + monthly enrichment cron (SteamGameEnrichment) never
// touches them — but the wishlist row UI still needs the content-hashed
// `library_hero` / `library_capsule` / `header` paths to render a real
// banner. Without this, unreleased titles whose publishers only shipped
// hashed assets (e.g. Silent Hill: Townfall, appid 1636440) miss every
// legacy filename in the image proxy chain and fall through to the
// generic `storepagebackground` ambient wash.
//
// Populated lazily by SteamService.resolveNames via
// IStoreBrowseService/GetItems with `include_assets: true`; one row per
// wishlist appid, no FK to SteamOwnedGame. Rows are refreshed when
// `fetchedAt` is older than the wishlist-asset TTL. Kept as a separate
// table rather than widening SteamGameEnrichment: the lifecycles are
// disjoint (wishlist churns weekly, owned-games once on add), the column
// set is far narrower (no review counts, no full description, no
// trailers), and the join model on the proxy side stays clean (each
// asset route walks `enrichment ∪ wishlistAsset` in that order).
model SteamWishlistAsset {
  appid                Int       @id
  assetUrlFormat       String?
  assetTimestamp       BigInt?
  libraryCapsulePath   String?
  libraryCapsule2xPath String?
  libraryHeroPath      String?
  libraryHero2xPath    String?
  headerPath           String?
  heroCapsulePath      String?
  // SteamGridDB fallback hero — populated by the SGDB backfill script when
  // `libraryHeroPath` is null (publisher hasn't shipped any modern library
  // asset, e.g. Townfall — appid 1636440). Same shape and constraints as
  // SteamGameEnrichment.sgdbHero*: full absolute CDN URL, width >= 1920,
  // refreshed on the same `SGDB_RECHECK_DAYS` watermark. Read from the
  // image proxy in `heroLarge` ahead of every other tier; for `hero` the
  // header.jpg legacy entry already 200s before this would be reached, so
  // the wishlist row's SGDB asset only meaningfully shows up on full-bleed
  // surfaces.
  sgdbHeroUrl          String?
  sgdbHeroWidth        Int?
  sgdbHeroHeight       Int?
  sgdbEnrichedAt       DateTime?
  fetchedAt            DateTime  @default(now())
}

// Per-game achievement schema from ISteamUserStats/GetSchemaForGame. Refreshed
// monthly by SteamAchievementSchemaPoller. Games with no achievements (CS2,
// demos, dedicated-launcher entries) leave no rows here — the meta sidecar's
// `achievementCount` records the empty-stats check so the poller doesn't
// thrash refetching empty schemas.
//
// `hidden = true` is Steam's spoiler flag: `displayName` + `description` render
// as `???` placeholders while the achievement is locked. Once the owner
// unlocks it the full text reveals (matches Steam's own client). Icon URLs
// are absolute community-CDN paths returned directly by the API.
model SteamGameAchievement {
  appid           Int
  apiName         String
  displayName     String
  description     String
  iconUrl         String
  iconGrayUrl     String
  hidden          Boolean  @default(false)
  schemaFetchedAt DateTime @default(now())

  game          SteamOwnedGame                  @relation(fields: [appid], references: [appid])
  unlock        SteamPlayerUnlock?
  rarity        SteamAchievementGlobalRarity?
  rarityHistory SteamAchievementRarityHistory[]

  @@id([appid, apiName])
}

// Per-owner unlock events from ISteamUserStats/GetPlayerAchievements. Each
// achievement can only be unlocked once, so `(appid, apiName)` is the natural
// PK. `unlockedAt` is the historical Steam `unlocktime` (every poll backfills
// real history retroactively — the "Day 1 looks like year N" property called
// out in the achievement family brainstorm). `recordedAt` is local — separates
// game-timeline data from observability.
model SteamPlayerUnlock {
  appid      Int
  apiName    String
  unlockedAt DateTime
  recordedAt DateTime @default(now())

  achievement SteamGameAchievement @relation(fields: [appid, apiName], references: [appid, apiName])

  @@id([appid, apiName])
  @@index([unlockedAt])
}

// Global unlock percentage per achievement from
// GetGlobalAchievementPercentagesForApp. Steam returns 0..100 as a float.
// Refreshed weekly. Drives the rarity badge on the per-game panel + the
// "rare unlock" annotation on the completion verdict card. Endpoint is
// unauthenticated but routed through the limiter for consistency.
// Stays the single current value, and stays the only thing the read path
// touches — every achievement panel, the trophy case and the recap join
// against it, so deriving "latest" out of the history table below would buy
// a DISTINCT ON per achievement for nothing.
model SteamAchievementGlobalRarity {
  appid    Int
  apiName  String
  percent  Float
  polledAt DateTime @default(now())

  achievement SteamGameAchievement @relation(fields: [appid, apiName], references: [appid, apiName])

  @@id([appid, apiName])
}

// Append-only observation log behind that current value. Steam's percentages
// move in both directions — a growing owner base pushes them down, remaining
// owners grinding pushes them up — and the upsert above overwrites, so the
// curve is unreconstructable after the fact. This table exists to accumulate
// it before there is anything worth rendering.
//
// A row is appended only when the value moves at Steam's own precision (it
// publishes one decimal), which is what keeps this at tens of thousands of
// rows a year rather than hundreds. There is deliberately no retention pass:
// pruning would destroy the long spans the table exists to hold.
//
// `observedAt` is when we looked, never when the achievement was unlocked.
// Unlock timestamps backfill retroactively (see SteamPlayerUnlock) while this
// series can only start at its first observation, so the two can never be
// reconciled for anything already owned.
model SteamAchievementRarityHistory {
  id         Int      @id @default(autoincrement())
  appid      Int
  apiName    String
  percent    Float
  observedAt DateTime @default(now())

  achievement SteamGameAchievement @relation(fields: [appid, apiName], references: [appid, apiName])

  @@index([appid, apiName, observedAt])
}

// Sidecar bookkeeping for the three achievement pollers (monthly schema,
// daily unlocks, weekly rarity). Separated from SteamGameEnrichment because
// the cadences and failure modes are independent — a schema-fetch failure
// shouldn't block enrichment, and vice versa.
//
// `achievementCount` is the only persisted result: null = unknown, 0 =
// checked, no achievements (skip future fetches), N > 0 = N achievements
// known. Lets the schema poller short-circuit games like CS2 / demos
// without re-fetching every month.
model SteamGameAchievementMeta {
  appid                Int       @id
  achievementCount     Int?
  lastSchemaCheckedAt  DateTime?
  lastUnlocksCheckedAt DateTime?
  lastRarityCheckedAt  DateTime?

  game SteamOwnedGame @relation(fields: [appid], references: [appid])
}

// Singleton-ish state for the live owner — refreshed every 2 min by
// SteamPlayerStatePoller (1 call to GetPlayerSummaries). Drives the
// "Now playing" chip and (in later S6 chunks) acts as the event source
// for persisted play sessions + event-driven achievement refresh.
//
// `currentAppid` mirrors GetPlayerSummaries' `gameid` field (null when
// not in-game). `currentGameName` is the `gameextrainfo` snapshot kept
// inline so the chip can render the human label without a second lookup
// against owned-games — and so it still renders for non-owned titles
// (friend's shared library, family-share, etc.). `personaState` stores
// the already-normalized string union from SteamSummary so the read
// endpoint doesn't have to re-map on every request.
model SteamPlayerState {
  steamId           String   @id
  personaName       String
  avatarUrl         String
  personaState      String
  profileVisibility Int
  currentAppid      Int?
  currentGameName   String?
  lastPolledAt      DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// One row per play session — opened when the owner enters a game, closed
// when they leave it (or transition to a different game). Driven by the
// every-2-min player-state poller diffing `currentAppid` transitions:
//   null → X   opens a session for X
//   X → null   closes the open session for X
//   X → Y      closes X, opens Y
//
// `endedAt` is set to the *previous* tick's `lastPolledAt` when the
// transition fires — that's the last moment we observed the owner still in
// the game, and it preserves a sensible close timestamp across poller
// downtime (a crash window of N hours closes at the pre-crash lastPolledAt,
// not the post-reboot wall clock). For orphan sessions with no matching
// previous state, falls back to now().
//
// `gameNameSnapshot` captures `gameextrainfo` at open time so historical
// rows stay legible after a publisher rebrand. `appid` is intentionally
// *not* an FK to SteamOwnedGame — family-share / non-owned titles still
// produce sessions.
model SteamPlaySession {
  id               String    @id @default(cuid())
  appid            Int
  gameNameSnapshot String
  startedAt        DateTime  @default(now())
  endedAt          DateTime?

  @@index([endedAt])
  @@index([appid, startedAt])
}

// Steam's global community-tag catalog (id → name). Pulled monthly from
// IStoreService/GetTagList. Resolves the `tagIds` carried on
// SteamGameEnrichment into human labels for the library filter popover.
// Decoupled from owned games on purpose — the catalog is global and Steam
// occasionally adds tags, so the cron is a separate concern from the per-app
// enrichment refresh. `updatedAt` carries the row's last touch (insert or
// rename); the `lastSyncedAt` API field uses the table's max of this column.
model SteamTag {
  id        Int      @id
  name      String
  updatedAt DateTime @default(now()) @updatedAt
}

model SteamPlaytimeSnapshot {
  appid                  Int
  snapshotDate           DateTime @db.Date
  playtimeForeverMinutes Int
  playtime2WeeksMinutes  Int?
  playtimeWindowsMinutes Int?
  playtimeMacMinutes     Int?
  playtimeLinuxMinutes   Int?
  playtimeDeckMinutes    Int?

  game SteamOwnedGame @relation(fields: [appid], references: [appid])

  @@id([appid, snapshotDate])
  @@index([snapshotDate])
}

model Match {
  matchId      String
  puuid        String
  // Riot's numeric queueId — the only stored queue identity. The rendered
  // label is derived at the display site via `queueLabel()`; storing it would
  // freeze an unmapped id's `Queue 3130` placeholder against later map
  // updates, and leave colliding labels (1700/1710 → "Arena") unfilterable.
  // Backfilled from MatchDetailCache by 20260801000000_lol_match_queue_id.
  queueId      Int
  champion     String
  kills        Int
  deaths       Int
  assists      Int
  win          Boolean
  durationSec  Int
  playedAt     DateTime
  items        Int[]
  laneOpponent Json?
  teamPosition String   @default("")
  gameVersion  String   @default("")
  visionScore  Int      @default(0)
  damageShare  Float    @default(0)
  firstBloodKill Boolean @default(false)
  csAt10       Int      @default(0)
  csAt15       Int      @default(0)
  goldAt10     Int      @default(0)
  goldAt15     Int      @default(0)
  teamGoldDiffAt15 Int  @default(0)
  // Per-minute team-gold-diff across every frame, user-team minus enemy-team
  // (positive = ahead). Drives the match-row gold-lead sparkline without
  // reading the full MatchTimelineCache JSON. Empty until backfilled or until
  // a fresh timeline-aware ingest writes the row.
  teamGoldDiffSeries Int[] @default([])
  deathTimings Int[]    @default([])
  deathXs      Int[]    @default([])
  deathYs      Int[]    @default([])
  killTimings  Int[]    @default([])
  killXs       Int[]    @default([])
  killYs       Int[]    @default([])
  remake       Boolean  @default(false)
  // True only when timeline-derived metrics (csAt15, goldAt10/15, death/kill
  // arrays) have been projected onto this row. csAt10 alone can no longer act
  // as that sentinel because PN3 seeds it from challenges.laneMinionsFirst10Minutes
  // for matches that never had a timeline fetched.
  hasTimeline  Boolean  @default(false)
  snapshotTier       String?
  snapshotRank       String?
  snapshotLp         Int?
  snapshotTierBefore String?
  snapshotRankBefore String?
  snapshotLpBefore   Int?

  summoner Summoner @relation(fields: [puuid], references: [puuid])

  @@id([matchId, puuid])
  @@index([puuid, playedAt])
  @@index([puuid, queueId, playedAt])
}

// One row per detected patch version. `version` matches ddragon's
// "{major}.{minor}" truncation (e.g. "26.10") — the third segment is a
// hotfix identifier that the wiki collapses into a single page per patch.
// `patchDate` is nullable: it's populated from the MediaWiki revision
// timestamp when available, otherwise left null and backfilled later.
model PatchVersion {
  version    String   @id
  patchDate  DateTime?
  fetchedAt  DateTime @default(now())

  changes PatchChange[]
}

// One row per change line, per subject (champion/item/rune), per patch.
// `section` is "champion" | "item" | "rune"; `subject` is the wiki name of
// that section's entry (champion name, item name, rune name). `ability` is
// only meaningful for champion rows (verbatim wiki ability name or "Base");
// always null for items/runes. `changeType` is a best-effort classification
// ("buff" | "nerf" | "adjustment" | "new_effect" | "removed") derived from
// the wiki prose; null when the direction is ambiguous.
model PatchChange {
  id           Int      @id @default(autoincrement())
  patchVersion String
  section      String   @default("champion")
  subject      String
  ability          String?
  slot             String?
  iconPath         String?
  changeText       String
  changeType       String?
  createdAt    DateTime @default(now())

  patch PatchVersion @relation(fields: [patchVersion], references: [version])

  @@index([patchVersion, section, subject])
}

// LoL static metadata pipeline (replaces the five client-side CDragon JSON
// fetches in apps/web). Wiki is the content source for descriptions, stats,
// recipes, and ability names; DDragon is retained narrowly as the id↔name
// bridge for resources wiki doesn't self-identify with Riot ids (summoner
// spells, runes). Two-source sync is drift-tolerant: each row carries
// `ddragonSyncedAt` and/or `wikiSyncedAt` so the API never lies about
// freshness, and content can be null until the lagging source catches up.

// Items self-identify on wiki via Module:ItemData/data's ["id"] field, so
// no DDragon involvement is needed. `recipe` is stored as wiki ingredient
// names (matches source); read-side resolves names → ids if required.
// `descriptionWikitext` holds the raw wiki template markup (e.g.
// "{{as|200% '''base''' AD}}"); `descriptionHtml` is the rendered output
// from MediaWiki's action=parse — populated in a follow-up chunk so 4a
// keeps the per-cron call count cheap. `iconWikiName` defaults to the
// item name; only stored separately when wiki disambiguates (e.g. item
// names colliding with champion names).
model LolItem {
  id                     Int      @id
  name                   String
  tier                   Int?
  itemType               Json     @default("[]")
  priceTotal             Int?
  recipe                 Json     @default("[]")
  categories             Json     @default("[]")
  stats                  Json     @default("{}")
  descriptionWikitext    String?
  descriptionHtml        String?
  iconWikiName           String?
  wikiSyncedAt           DateTime
  wikiSyncedPatchVersion String?
}

// Champions identify themselves in Match-V5 by both numeric `championId`
// and `championName`, so `id` matches Riot's championKey int. `alias` is
// the DDragon string id used in icon URL paths (e.g. "MonkeyKing"); `name`
// is the wiki display name ("Wukong"). `roles` are the DDragon `tags`
// array (Fighter/Tank/Mage/Marksman/Assassin/Support) — legacy taxonomy
// that DDragon hasn't updated. `modernClasses` and `modernSubclasses`
// carry Riot's current wiki-canonical taxonomy (Slayer/Controller/
// Specialist + Burst/Skirmisher/Enchanter/etc.) inverted from wiki's
// `Category:<Class>_champion` / `Category:<Subclass>_champion` pages.
model LolChampion {
  id                     Int      @id
  alias                  String   @unique
  name                   String   @unique
  roles                  Json     @default("[]")
  modernClasses          Json     @default("[]")
  modernSubclasses       Json     @default("[]")
  ddragonSyncedAt        DateTime
  wikiSyncedAt           DateTime?
  wikiSyncedPatchVersion String?

  abilities LolChampionAbility[]
}

// One row per ability *name variant* per champion + slot. Some champions
// expose multiple named variants in a single slot (Karma's W is both
// "Focused Resolve" and "Renewal"; Lee Sin's W lists "Safeguard" and
// "Iron Will"). `index` orders them by appearance in the wiki module so
// the patch-notes resolver can match either variant to the same slot.
// `slot` is "Passive" | "Q" | "W" | "E" | "R".
model LolChampionAbility {
  championId             Int
  slot                   String
  abilityIndex           Int      @default(0)
  name                   String
  iconWikiName           String?
  // DDragon image filename (`AatroxQ.png`, `Aatrox_Passive.png`). Populated
  // from `championFull.json` at sync time. Powers the 3rd-stage fallback
  // in `LolImageService.ability()` when wiki + CDragon both fail. Slot
  // decides which DDragon path segment (passive vs spell) at proxy time.
  ddragonImageFile       String?
  descriptionWikitext    String?
  descriptionHtml        String?
  // Watermark for the lazy resolver — see ensureAbilityDescription. Null
  // until the first per-ability fetch lands; rows whose value doesn't
  // match the current patch are re-fetched on next read.
  wikiSyncedPatchVersion String?

  champion LolChampion @relation(fields: [championId], references: [id], onDelete: Cascade)

  @@id([championId, slot, abilityIndex])
}

// Summoner spells — DDragon's `summoner.json` is the id↔name bridge.
// Wiki carries the description in `Template:Summoner spell {Name}` or
// `Module:SpellData/data`; fetched per-spell in a follow-up chunk.
model LolSummonerSpell {
  id                     Int      @id
  name                   String
  iconWikiName           String?
  descriptionWikitext    String?
  descriptionHtml        String?
  ddragonSyncedAt        DateTime
  wikiSyncedAt           DateTime?
  wikiSyncedPatchVersion String?
  missingSyncCycles      Int      @default(0)
  retiredAt              DateTime?
}

// Runes — DDragon's `runesReforged.json` is the id↔name bridge. `path` is
// the rune tree name ("Precision", "Domination", etc.) and `slot` is the
// keystone/minor slot label ("Keystone", "Slot1" … "Slot3"), both derived
// from the DDragon payload's nested shape. `missingSyncCycles` powers the
// drift-tolerant retirement check: a perkId can briefly disappear between
// Riot ship + CDN propagation, so we wait N consecutive missing cycles
// before marking `retiredAt`. Phase Rush → Stormraider's Surge is the
// canonical churn case this protects against.
model LolPerk {
  id                     Int      @id
  name                   String
  path                   String?
  slot                   String?
  iconWikiName           String?
  descriptionWikitext    String?
  descriptionHtml        String?
  ddragonSyncedAt        DateTime
  wikiSyncedAt           DateTime?
  wikiSyncedPatchVersion String?
  missingSyncCycles      Int      @default(0)
  retiredAt              DateTime?
}

// Profile icons — sourced from wiki `Module:IconData/data`. `id` is Riot's
// numeric profileIconId returned by the Summoner-V4 API; `title` is the
// wiki's editorial title (the key under which it appears in the module),
// which doubles as the image filename slug — wiki serves
// `{Title with underscores}_profileicon.png` for every entry. `availability`
// / `release` are kept for future filtering (Available vs Legacy vs Limited;
// chronological grouping). No DDragon bridge: wiki self-identifies these by
// id alone, the same way item rows do.
model LolProfileIcon {
  id           Int      @id
  title        String
  availability String?
  release      Int?
  wikiSyncedAt DateTime
}

// Owner sessions. There is no `User` table: a single GitHub numeric id is the
// entire authorization model, so holding the row *is* the proof. Multiple rows
// with the same `githubUserId` are normal — one per device — and revocation is
// per row.
//
// `tokenHash` is the SHA-256 of the cookie value, never the value itself: the
// table must be a record that sessions existed, not a list of working
// credentials that a backup dump or a stray query log hands over. Plain SHA-256
// rather than bcrypt/argon2 because the input is 256 bits of `randomBytes`, not
// a human password — there is nothing to brute-force, and a slow hash would
// only tax every guarded request.
//
// Two expiries, deliberately. `expiresAt` slides forward on use so the owner
// isn't logged out mid-week; `absoluteExpiresAt` never moves, so one successful
// login can't become indefinite access via a session touched once a month.
model Session {
  tokenHash         String   @id
  githubUserId      Int
  // Cached for display only — the id is what authorizes, and a login can be
  // transferred to another person.
  githubLogin       String
  createdAt         DateTime @default(now())
  expiresAt         DateTime
  absoluteExpiresAt DateTime

  @@index([expiresAt])
}

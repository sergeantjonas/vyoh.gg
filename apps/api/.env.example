DATABASE_URL=postgresql://vyoh:vyoh@localhost:5432/vyoh

# Get a development key (24h-expiring) from https://developer.riotgames.com/
RIOT_API_KEY=RGAPI-XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX

# Get a Web API key (non-expiring) from https://steamcommunity.com/dev/apikey
# SteamID64 is hardcoded in apps/api/src/steam/steam.config.ts.
STEAM_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

STEAM_GRIDDB_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Owner auth — GitHub OAuth gating the status-page admin actions. Register an
# OAuth app (not a GitHub App) at https://github.com/settings/applications/new
# with the callback set to <api-origin>/auth/github/callback, then generate a
# client secret. Prod wants its own app: the secret is shared across every
# redirect URI on one registration.
#
# The allowed identity is the *numeric* GitHub user id, not the username —
# usernames can be transferred to someone else. Read yours with `gh api user`.
OWNER_GITHUB_USER_ID=00000000
GITHUB_OAUTH_CLIENT_ID=XXXXXXXXXXXXXXXXXXXX
GITHUB_OAUTH_CLIENT_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# HMAC key for the OAuth state token only — session ids are random rather than
# signed, so rotating this invalidates in-flight logins, not live sessions.
# Generate: node -e 'console.log(require("node:crypto").randomBytes(32).toString("base64url"))'
SESSION_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Leave empty in dev — a Domain attribute on a localhost cookie stops the
# browser sending it back. Set to `.vyoh.gg` only if api and web split subdomains.
SESSION_COOKIE_DOMAIN=

# Comma-separated CORS allowlist. Optional in dev — unset, the api allows any
# http://localhost:<port>, which covers Vite on :2009 and probes on ephemeral
# ports. Required under NODE_ENV=production; compose.prod.yaml supplies it.
# WEB_ORIGIN=https://vyoh.gg,https://www.vyoh.gg

# Optional overrides (all have safe defaults)
PORT=2010
CUTOFF_DAYS=90
MATCH_SYNC_ENABLED=true
LOL_PREWARM=0
STEAM_PREWARM=0
